---
import { templates } from '../data/templates';
---

<section id="templates" aria-labelledby="templates-h" class="border-b border-line bg-bg">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
    <p class="font-mono text-[11px] font-semibold tracking-[0.2em] text-accent uppercase">06 · Templates</p>
    <h2 id="templates-h" class="mt-3 font-display text-3xl leading-[1.2] font-bold tracking-tight text-ink md:text-4xl">
      13 个提示词模板，自动选择
    </h2>
    <p class="mt-4 max-w-[52ch] text-[15px] leading-relaxed text-muted">
      为每个任务自动挑选正确的架构并静默路由。横向滑动查看全部模板。
    </p>
  </div>

  <div class="relative mx-auto max-w-6xl">
    <div
      class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 bg-gradient-to-r from-surface to-transparent"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-gradient-to-l from-surface to-transparent"
      aria-hidden="true"
    ></div>
    <div
      role="region"
      aria-label="模板列表，可横向滚动"
      tabindex="0"
      class="scroll-slim scroll-px-4 snap-x snap-mandatory overflow-x-auto px-4 pb-6 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent sm:px-6 lg:pb-10"
    >
      <ul class="flex w-max gap-4 pr-6">
        {templates.map((t, i) => (
          <li class="reveal w-[270px] shrink-0 snap-start rounded-card border border-line bg-bg p-5 transition-transform duration-200 hover:-translate-y-0.5 hover:border-line-strong hover:shadow-[0_10px_24px_-16px_rgba(13,11,16,0.35)] min-h-[140px] flex flex-col">
            <div class="flex items-center justify-between">
              <h3 class="font-mono text-[13.5px] font-semibold text-ink">{t.name}</h3>
              <span class="font-mono text-[11px] text-faint">#{String(i+1).padStart(2,'0')}</span>
            </div>
            <p class="mt-1 text-[13px] text-accent">{t.zh}</p>
            <p class="mt-auto text-sm leading-relaxed text-muted">{t.best}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
