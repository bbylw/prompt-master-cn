---
import NavActions from '../islands/NavActions';
import StarMark from './StarMark.astro';
---

<header
  id="site-header"
  class="nav-blur site-header sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6"
    aria-label="主导航"
  >
    <a href="#top" class="flex items-center gap-2.5 font-display text-[15px] font-bold tracking-tight text-ink">
      <StarMark class="h-6 w-6 shrink-0" />
      Prompt Master
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      <a href="#usage" class="nav-link rounded-full px-3.5 py-2 text-sm font-medium text-muted transition-colors duration-200 hover:bg-elevated hover:text-ink" data-spy="usage">用法</a>
      <a href="#how" class="nav-link rounded-full px-3.5 py-2 text-sm font-medium text-muted transition-colors duration-200 hover:bg-elevated hover:text-ink" data-spy="how">原理</a>
      <a href="#profiles" class="nav-link rounded-full px-3.5 py-2 text-sm font-medium text-muted transition-colors duration-200 hover:bg-elevated hover:text-ink" data-spy="profiles">工具档案</a>
      <a href="#patterns" class="nav-link rounded-full px-3.5 py-2 text-sm font-medium text-muted transition-colors duration-200 hover:bg-elevated hover:text-ink" data-spy="patterns">模式库</a>
      <a href="#install" class="nav-link rounded-full px-3.5 py-2 text-sm font-medium text-muted transition-colors duration-200 hover:bg-elevated hover:text-ink" data-spy="install">安装</a>
    </div>

    <NavActions client:idle />
  </nav>

  <script is:inline defer>
    (function() {
      const init = () => {
        // Elevate the header once content slides underneath it.
        const header = document.getElementById('site-header');
        if (header) {
          const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        const links = document.querySelectorAll('header nav a[data-spy]');
        const map = new Map();
        links.forEach(l => map.set(l.getAttribute('data-spy'), l));
        const visible = new Set();
        const obs = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) visible.add(e.target.id);
            else visible.delete(e.target.id);
          }
          links.forEach(l => l.removeAttribute('aria-current'));
          const next = [...visible].map(id => map.get(id)).find(Boolean);
          if (next) next.setAttribute('aria-current', 'true');
        }, { rootMargin: '-30% 0px -60% 0px' });
        ['usage','how','profiles','patterns','install'].forEach(id => {
          const el = document.getElementById(id);
          if (el) obs.observe(el);
        });
      };
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init, { once: true });
      } else {
        init();
      }
    })();
  </script>
</header>
