---
import StarMark from './StarMark.astro';

const groups: { title: string; links: { label: string; href: string; external?: boolean }[] }[] = [
  {
    title: '内容',
    links: [
      { label: '用法示例', href: '#usage' },
      { label: '工作原理', href: '#how' },
      { label: '工具档案', href: '#profiles' },
      { label: '提示词模板', href: '#templates' },
      { label: '烧额度模式库', href: '#patterns' },
    ],
  },
  {
    title: '开始使用',
    links: [
      { label: '安装步骤', href: '#install' },
      { label: '记忆块系统', href: '#memory' },
      { label: '版本历史', href: '#changelog' },
    ],
  },
  {
    title: '外部链接',
    links: [
      { label: 'GitHub 仓库', href: 'https://github.com/nidhinjs/prompt-master', external: true },
      { label: 'MIT 许可证', href: 'https://github.com/nidhinjs/prompt-master/blob/main/LICENSE', external: true },
    ],
  },
];
---

<footer class="border-t border-line bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2.5 font-display text-[15px] font-bold tracking-tight text-ink">
          <StarMark class="h-6 w-6 shrink-0" />
          Prompt Master
        </div>
        <p class="mt-3 max-w-[36ch] text-sm leading-relaxed text-muted">
          一项 Claude 技能，为任何 AI 工具撰写精准提示词。每一个词都在承担作用。
        </p>
      </div>
      {groups.map((group) => (
        <nav aria-label={group.title}>
          <h3 class="text-[13px] font-semibold text-ink">{group.title}</h3>
          <ul class="mt-3.5 space-y-2.5">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="rounded-sm text-sm text-muted transition-colors duration-200 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                  {...link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="mt-12 border-t border-line pt-6 text-[13px] text-faint">
      MIT 许可证。本项目为 Prompt Master 技能的中文介绍站，非官方产品页面。
    </div>
  </div>
</footer>
