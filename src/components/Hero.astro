---
import PromptCard from '../islands/PromptCard';

const mjPrompt = `lone samurai standing in heavy rain at night, traditional armor,
neon reflections on wet cobblestone street, cinematic lighting,
dramatic shadows, fog, ultra detailed, photorealistic,
shallow depth of field --ar 16:9 --v 6 --style raw

negative: blurry, low quality, watermark, cartoon, anime, extra limbs`;
---

<section id="top" class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute -top-40 right-[-10%] h-[480px] w-[480px] rounded-full bg-[radial-gradient(circle,var(--accent-soft),transparent_65%)]"
    aria-hidden="true"
  ></div>

  <div
    class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-4 pt-14 pb-16 sm:px-6 lg:grid-cols-[1.02fr_1fr] lg:gap-16 lg:pt-20 lg:pb-24"
  >
    <div>
      <h1
        class="max-w-[15ch] font-display text-[2.4rem] leading-[1.12] font-bold tracking-tight text-ink md:text-[3.1rem]"
      >
        为任何 AI 工具，写出<span class="text-accent">一次到位</span>的提示词
      </h1>
      <p class="mt-5 max-w-[44ch] text-[15px] leading-relaxed text-muted md:text-base">
        零 token 浪费，完整上下文与记忆保持。不必重试四次，才拿到第一次就该得到的答案。
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="https://github.com/nidhinjs/prompt-master"
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-12 items-center gap-2 rounded-full bg-accent px-6 text-[15px] font-semibold text-accent-ink transition-transform duration-200 hover:-translate-y-0.5 active:translate-y-0"
        >
          获取技能
        </a>
        <a
          href="#examples"
          class="flex h-12 items-center rounded-full border border-line-strong px-6 text-[15px] font-semibold text-ink transition-colors duration-200 hover:border-ink active:scale-[0.99]"
        >
          看一个真实例子
        </a>
      </div>
    </div>

    <PromptCard
      client:load
      request="给我写一个 midjourney 提示词：一个写实风格的武士在雨夜中伫立"
      prompt={mjPrompt}
      meta={{
        tool: 'Midjourney',
        framework: 'Visual Descriptor（视觉描述符）',
        tokens: '轻量，约 60',
        strategy:
          '用逗号分隔的描述符代替整句散文，光照与氛围锚定在前，锁定宽高比和版本，负向提示防止风格漂移。',
      }}
    />
  </div>
</section>
